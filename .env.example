# Resend (transactional email — contact + invite forms)
# https://resend.com/api-keys — scope to "Sending access" only.
RESEND_API_KEY=

# Verified onev.live sender. Defaults to "OneVoice <noreply@onev.live>" if unset.
# RESEND_FROM_EMAIL="OneVoice <noreply@onev.live>"

# Where contact/invite form submissions land. Defaults to EMAIL from lib/links.ts
# (hello@onev.live) if unset.
# CONTACT_TO_EMAIL=hello@onev.live

# Sanity CMS (member roster + gallery photos). Public identifiers, safe to
# expose to the browser — no secret token needed for reading published
# content from a public dataset. See studio/sanity.config.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=erpqd8b3
NEXT_PUBLIC_SANITY_DATASET=production
